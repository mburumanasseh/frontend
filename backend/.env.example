# Application
APP_NAME="Honey Shop API"
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Security
SECRET_KEY=change-this-to-a-long-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# Database
DATABASE_URL=postgresql://honey:honey@localhost:5432/honey_shop

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://frontend-snowy-two-50.vercel.app

# One-time secret to promote a user to admin via POST /api/v1/auth/bootstrap-admin
BOOTSTRAP_SECRET=change-me-to-a-long-random-string

# Cloudinary (product images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=honey-shop

# Email — welcome messages on register
# Option A: Resend (https://resend.com)
RESEND_API_KEY=
EMAIL_FROM=Mercy Gold Honey <onboarding@yourdomain.com>

# Option B: SMTP (e.g. Gmail app password)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_USE_TLS=true
